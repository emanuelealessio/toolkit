{
  "outputStyle": "italiano-conciso",
  "permissions": {
    "allow": [
      "Skill",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git remote get-url:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(ls:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/safety-bash-guard.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/precompact-handoff.sh"
          }
        ]
      }
    ]
  }
}
